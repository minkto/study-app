generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// *
///  * url and Direct URL differ as the DATABASE_URL is what is used for queries,
///  * and the DIRECT_URL is what is used for Migrations.
model Statuses {
  status_id Int        @id @unique
  name      String
  chapter   Chapters[]

  @@map("statuses")
}

model Categories {
  category_id Int         @id @default(autoincrement())
  name        String
  description String?     @db.VarChar(256)
  created_at  DateTime    @default(now()) @db.Timestamptz(0)
  updated_at  DateTime    @default(now()) @db.Timestamptz(0)
  color       String      @default("#ffffff") @db.VarChar(7)
  user_id     String      @db.Uuid
  users       Users       @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  resource    Resources[]

  @@unique([user_id, name])
  @@map("categories")
}

model Resources {
  resource_id Int         @id @default(autoincrement())
  user_id     String      @db.Uuid
  user        Users       @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  description String?
  category_id Int?
  is_pinned   Boolean     @default(false)
  chapters    Chapters[]
  categories  Categories? @relation(fields: [category_id], references: [category_id])
  created_at  DateTime    @default(now()) @db.Timestamptz(0)
  updated_at  DateTime    @default(now()) @db.Timestamptz(0)

  @@map("resources")
}

model Chapters {
  chapter_id              Int       @id @default(autoincrement())
  resource_id             Int
  status_id               Int       @default(0)
  name                    String
  url                     String?   @db.VarChar(800)
  original_date_completed DateTime?
  last_date_completed     DateTime?
  description             String?
  resource                Resources @relation(fields: [resource_id], references: [resource_id])
  status                  Statuses  @relation(fields: [status_id], references: [status_id])
  notes                   Notes[]

  @@map("chapters")
}

model Notes {
  note_id    Int      @id @default(autoincrement())
  chapter_id Int
  content    String?  @db.VarChar(256)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @default(now()) @db.Timestamptz(0)
  chapter    Chapters @relation(fields: [chapter_id], references: [chapter_id])

  @@map("notes")
}

model Users {
  user_id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_user_id         String        @unique
  deletion_requested_at DateTime?     @db.Timestamptz(0)
  categories            Categories[]
  resources             Resources[]
  user_settings         UserSettings?

  @@map("users")
}

model UserSettings {
  user_setting_id                       Int    @id @default(autoincrement())
  ai_helper_credits                     Int    @default(0)
  global_chapter_days_before_review_due Int    @default(30)
  user_id                               String @unique @db.Uuid
  user                                  Users  @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_settings")
}
